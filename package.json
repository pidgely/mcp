{
  "name": "@pidgely/mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for Pidgely: let AI agents send email, manage domains, contacts, broadcasts and more.",
  "keywords": ["pidgely", "mcp", "model-context-protocol", "ai-agents", "email", "email-api", "claude", "cursor", "llm"],
  "homepage": "https://docs.pidgely.com",
  "bugs": "https://github.com/pidgely/mcp/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pidgely/mcp.git"
  },
  "license": "MIT",
  "author": "Caotec Serviços em Tecnologia Ltda <dev@fexxo.com.br>",
  "type": "module",
  "bin": {
    "pidgely-mcp": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:dist": "node scripts/smoke.mjs",
    "inspect": "npx @modelcontextprotocol/inspector node dist/cli.js",
    "prepublishOnly": "npm run build",
    "version": "node scripts/sync-version.mjs && git add src/version.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^20.19.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.0",
    "pidgely": "github:pidgely/pidgely-node#688c8cc978a428596dbd7b58fb1bc9fc77a9e12a",
    "tsup": "^8.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
